{
  "name": "terminal-ia",
  "version": "0.1.0",
  "description": "Terminal multi-projeto com Claude/Codex, comandos PowerShell e gestao de tarefas com persistencia local",
  "main": "src/main/main.js",
  "author": "Altis Sistemas",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "vendor": "node scripts/copy-vendor.js",
    "start": "npm run vendor && electron .",
    "dist": "npm run vendor && electron-builder --win",
    "dist:portable": "npm run vendor && electron-builder --win portable",
    "pack": "npm run vendor && electron-builder --dir",
    "release": "npm run vendor && electron-builder --win --publish always",
    "icone": "node scripts/gerar-icone.js"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.altis.terminalia",
    "productName": "Terminal IA",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/renderer/vendor/*.map",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@lydell/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TerminalIA-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Terminal IA"
    },
    "portable": {
      "artifactName": "TerminalIA-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PREENCHER_DONO_DO_REPO",
        "repo": "terminal_ia",
        "private": true
      }
    ]
  }
}
